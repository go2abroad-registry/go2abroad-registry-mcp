{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go2abroad-registry-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "mcp-registry.go2abroad.space/*",
      "zone_name": "go2abroad.space"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "transcend-go2abroad",
      "database_id": "16c9e5cc-667c-4c1c-ad79-7fd48d9aed11"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_SESSION",
        "class_name": "McpSseSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McpSseSession"]
    }
  ]
}
